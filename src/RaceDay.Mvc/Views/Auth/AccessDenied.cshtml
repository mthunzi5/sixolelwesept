@{
    ViewData["Title"] = "Access denied";
    var role = Context.Session.GetUserRole();
}

<div class="rd-card">
    <div class="rd-empty">
        <i class="bi bi-shield-lock-fill"></i>
        <h3>This area isn't for your account</h3>
        <p>
            You're signed in as @(role == UserRole.Organiser ? "an Organiser" : "a Participant").
            This page belongs to @(role == UserRole.Organiser ? "Participants" : "Organisers").
        </p>
        @if (role == UserRole.Organiser)
        {
            <a class="btn btn-primary" asp-controller="Organiser" asp-action="Dashboard"><i class="bi bi-speedometer2"></i> Go to my dashboard</a>
        }
        else
        {
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index"><i class="bi bi-flag"></i> Browse events</a>
        }
    </div>
</div>
