@model EnrolmentsViewModel
@{
    ViewData["Title"] = $"Enrolments · {Model.Event.EventName}";
    var confirmed = Model.Enrolments.Count(e => e.Status == EnrolmentStatus.Confirmed);
    var pending = Model.Enrolments.Count(e => e.Status == EnrolmentStatus.Pending);
    var withdrawn = Model.Enrolments.Count(e => e.Status == EnrolmentStatus.Withdrawn);
}

<partial name="_EventTabs" model="Model.Event" />

<div class="row g-4 mb-4">
    <div class="col-sm-4">
        <div class="rd-card rd-stat">
            <div class="rd-stat-icon" style="background: rgba(31,157,85,.12); color: var(--rd-success);"><i class="bi bi-check-circle-fill"></i></div>
            <div><div class="rd-stat-value">@confirmed</div><div class="rd-stat-label">Confirmed</div></div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="rd-card rd-stat">
            <div class="rd-stat-icon" style="background: rgba(244,161,0,.15); color: var(--rd-warning);"><i class="bi bi-hourglass-split"></i></div>
            <div><div class="rd-stat-value">@pending</div><div class="rd-stat-label">Pending payment</div></div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="rd-card rd-stat">
            <div class="rd-stat-icon" style="background: #eceff3; color: var(--rd-muted);"><i class="bi bi-x-circle-fill"></i></div>
            <div><div class="rd-stat-value">@withdrawn</div><div class="rd-stat-label">Withdrawn</div></div>
        </div>
    </div>
</div>

<form method="get" asp-action="Enrolments" asp-route-id="@Model.Event.EventId" class="d-flex flex-wrap gap-2 align-items-center mb-3">
    <label for="categoryId" class="form-label mb-0">Category</label>
    <select id="categoryId" name="categoryId" class="form-select" style="width:auto" onchange="this.form.submit()">
        <option value="">All categories</option>
        @foreach (var c in Model.Event.Categories)
        {
            <option value="@c.CategoryId" selected="@(c.CategoryId == Model.CategoryId)">@c.CategoryName</option>
        }
    </select>
    <noscript><button type="submit" class="btn btn-sm btn-primary">Show</button></noscript>
</form>

@if (Model.Enrolments.Count == 0)
{
    <div class="rd-card">
        <div class="rd-empty">
            <i class="bi bi-people"></i>
            <h3>No enrolments yet</h3>
            <p>Share the event page so participants can sign up.</p>
        </div>
    </div>
}
else
{
    <div class="rd-card">
        <div class="table-responsive">
            <table class="table rd-table">
                <thead>
                    <tr>
                        <th>Bib</th>
                        <th>Participant</th>
                        <th>Category</th>
                        <th>Enrolled</th>
                        <th>Payment</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var en in Model.Enrolments)
                    {
                        <tr>
                            <td><span class="rd-bib">@en.BibNumber</span></td>
                            <td class="fw-semibold">@en.ParticipantName</td>
                            <td>@en.CategoryName</td>
                            <td class="text-nowrap">@en.EnrolmentDate.ToLocalTime().ToString("d MMM yyyy")</td>
                            <td>
                                @if (en.PaymentStatus is PaymentStatus ps)
                                {
                                    <span class="rd-badge @Display.BadgeClass(ps)">@ps</span>
                                }
                                else if (en.EntryFee == 0)
                                {
                                    <span class="text-muted small">Free</span>
                                }
                                else
                                {
                                    <span class="text-muted small">Not paid</span>
                                }
                            </td>
                            <td><span class="rd-badge @Display.BadgeClass(en.Status)">@en.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
