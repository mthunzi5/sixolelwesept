@model CategoriesViewModel
@{
    ViewData["Title"] = $"Categories · {Model.Event.EventName}";
    var categories = Model.Event.Categories;
}

<partial name="_EventTabs" model="Model.Event" />

<div class="row g-4">
    <div class="col-lg-7">
        <div class="rd-card">
            <div class="rd-card-body pb-0"><h2 class="rd-card-title">Categories (@categories.Count)</h2></div>
            @if (categories.Count == 0)
            {
                <div class="rd-empty">
                    <i class="bi bi-list-ul"></i>
                    <h3>No categories yet</h3>
                    <p>Participants pick a category when they enrol. Add at least one, e.g. 10km or Under 20.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table rd-table">
                        <thead>
                            <tr><th>Category</th><th>Type</th><th>Distance</th><th>Fee</th><th>Entries</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var c in categories)
                            {
                                <tr>
                                    <td>
                                        <strong>@c.CategoryName</strong>
                                        @if (c.CategoryType == CategoryType.Age)
                                        {
                                            <div class="small text-muted">Age @(c.MinAge?.ToString() ?? "any") – @(c.MaxAge?.ToString() ?? "any")</div>
                                        }
                                    </td>
                                    <td><span class="rd-badge @(c.CategoryType == CategoryType.Age ? "rd-badge-info" : "rd-badge-brand")">@c.CategoryType</span></td>
                                    <td>@Display.Km(c.DistanceKm)</td>
                                    <td>@Display.Money(c.EntryFee)</td>
                                    <td>@c.SpotsTaken / @c.MaxParticipants</td>
                                    <td class="text-end">
                                        <a asp-action="Enrolments" asp-route-id="@Model.Event.EventId" asp-route-categoryId="@c.CategoryId" class="btn btn-sm btn-outline-primary" title="View entrants"><i class="bi bi-people-fill"></i></a>
                                        <form asp-action="DeleteCategory" asp-route-id="@Model.Event.EventId" method="post" class="d-inline" data-confirm="Remove the '@c.CategoryName' category?">
                                            <input type="hidden" name="categoryId" value="@c.CategoryId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove" disabled="@(c.SpotsTaken > 0)"><i class="bi bi-trash3"></i></button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="rd-card rd-card-body">
            <h2 class="rd-card-title">Add a category</h2>
            <form asp-action="AddCategory" asp-route-id="@Model.Event.EventId" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert rd-alert rd-alert-danger"></div>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Form.CategoryType" class="form-label"></label>
                        <select asp-for="Form.CategoryType" asp-items="Html.GetEnumSelectList<CategoryType>()" class="form-select"></select>
                        <div class="form-text">Distance categories split entrants by how far they race (5km, 21km); age categories by age group (Under 20, Senior).</div>
                    </div>
                    <div class="col-12">
                        <label asp-for="Form.CategoryName" class="form-label"></label>
                        <input asp-for="Form.CategoryName" class="form-control" placeholder="e.g. 10km or Under 20" />
                        <span asp-validation-for="Form.CategoryName"></span>
                    </div>
                    <div class="col-6" data-age-field>
                        <label asp-for="Form.MinAge" class="form-label"></label>
                        <input asp-for="Form.MinAge" type="number" min="0" max="120" class="form-control" />
                        <span asp-validation-for="Form.MinAge"></span>
                    </div>
                    <div class="col-6" data-age-field>
                        <label asp-for="Form.MaxAge" class="form-label"></label>
                        <input asp-for="Form.MaxAge" type="number" min="0" max="120" class="form-control" />
                        <span asp-validation-for="Form.MaxAge"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="Form.DistanceKm" class="form-label"></label>
                        <input asp-for="Form.DistanceKm" type="number" step="0.01" min="0.1" class="form-control" />
                        <span asp-validation-for="Form.DistanceKm"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="Form.EntryFee" class="form-label"></label>
                        <input asp-for="Form.EntryFee" type="number" step="0.01" min="0" class="form-control" />
                        <span asp-validation-for="Form.EntryFee"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Form.MaxParticipants" class="form-label"></label>
                        <input asp-for="Form.MaxParticipants" type="number" min="1" class="form-control" />
                        <span asp-validation-for="Form.MaxParticipants"></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary w-100 mt-4"><i class="bi bi-plus-circle-fill"></i> Add category</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
