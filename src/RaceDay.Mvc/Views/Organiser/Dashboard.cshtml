@model OrganiserDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    var upcoming = Model.Upcoming;
    var next = upcoming.FirstOrDefault();
    var firstName = Context.Session.GetFullName().Split(' ')[0];
    var today = DateOnly.FromDateTime(DateTime.Today);
}

<div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
    <partial name="_PageHeader" model='new PageHeader($"Welcome, {firstName}", "Here is how your events are shaping up.", "bi-speedometer2")' />
    <a asp-action="Create" class="btn btn-primary mb-4"><i class="bi bi-plus-circle-fill"></i> Create event</a>
</div>

<div class="row g-4 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="rd-card rd-stat">
            <div class="rd-stat-icon"><i class="bi bi-calendar-event"></i></div>
            <div><div class="rd-stat-value">@Model.Events.Count</div><div class="rd-stat-label">Events created</div></div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="rd-card rd-stat">
            <div class="rd-stat-icon"><i class="bi bi-people-fill"></i></div>
            <div><div class="rd-stat-value">@Model.TotalEnrolments</div><div class="rd-stat-label">Total enrolments</div></div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="rd-card rd-stat">
            <div class="rd-stat-icon"><i class="bi bi-hourglass-split"></i></div>
            <div><div class="rd-stat-value">@upcoming.Count</div><div class="rd-stat-label">Upcoming events</div></div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="rd-card rd-stat">
            <div class="rd-stat-icon"><i class="bi bi-flag-fill"></i></div>
            <div>
                <div class="rd-stat-value">@(next is null ? "-" : Display.ShortDate(next.EventDate))</div>
                <div class="rd-stat-label">@(next is null ? "No upcoming event" : $"Next: {next.EventName}")</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="rd-card">
            <div class="rd-card-body pb-0"><h2 class="rd-card-title">Enrolments per event</h2></div>
            @if (Model.Events.Count == 0)
            {
                <div class="rd-empty">
                    <i class="bi bi-calendar-plus"></i>
                    <h3>No events yet</h3>
                    <p>Create your first event to start taking entries.</p>
                    <a asp-action="Create" class="btn btn-primary">Create event</a>
                </div>
            }
            else
            {
                var max = Math.Max(1, Model.Events.Max(e => e.EnrolmentCount));
                <div class="table-responsive">
                    <table class="table rd-table">
                        <thead>
                            <tr><th>Event</th><th>Date</th><th>Status</th><th style="min-width: 12rem;">Enrolments</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var ev in Model.Events.OrderBy(e => e.EventDate < today).ThenBy(e => e.EventDate))
                            {
                                <tr>
                                    <td><strong>@ev.EventName</strong><div class="small text-muted">@ev.Location</div></td>
                                    <td class="text-nowrap">@Display.Date(ev.EventDate)</td>
                                    <td><span class="rd-badge @Display.BadgeClass(ev.Status)">@ev.Status</span></td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-fill" style="height: .55rem;" role="progressbar" aria-label="Enrolments" aria-valuenow="@ev.EnrolmentCount" aria-valuemin="0" aria-valuemax="@max">
                                                <div class="progress-bar" style="width: @(ev.EnrolmentCount * 100 / max)%; background: var(--rd-orange);"></div>
                                            </div>
                                            <strong>@ev.EnrolmentCount</strong>
                                        </div>
                                    </td>
                                    <td class="text-end"><a asp-action="Enrolments" asp-route-id="@ev.EventId" class="btn btn-sm btn-outline-primary">View</a></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-4">
        <div class="rd-card rd-card-body h-100">
            <h2 class="rd-card-title">Upcoming dates</h2>
            @if (upcoming.Count == 0)
            {
                <p class="text-muted mb-0">Nothing scheduled. Time to plan the next race!</p>
            }
            else
            {
                <ul class="list-unstyled mb-0">
                    @foreach (var ev in upcoming.Take(6))
                    {
                        var days = ev.EventDate.DayNumber - today.DayNumber;
                        <li class="d-flex gap-3 align-items-center py-2 border-bottom">
                            <span class="rd-date-chip position-static">@Display.ShortDate(ev.EventDate)</span>
                            <div class="flex-fill">
                                <a asp-controller="Home" asp-action="Event" asp-route-id="@ev.EventId" class="fw-semibold text-decoration-none" style="color: var(--rd-navy)">@ev.EventName</a>
                                <div class="small text-muted">@(days == 0 ? "Today!" : days == 1 ? "Tomorrow" : $"In {days} days") · @ev.EnrolmentCount entered</div>
                            </div>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
