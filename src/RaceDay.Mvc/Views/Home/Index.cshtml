@model HomeViewModel
@{
    ViewData["Title"] = "Upcoming events";
    var subtitle = Model.Events.Count == 1 ? "1 event open for entries" : $"{Model.Events.Count} events open for entries";
    var hasFilters = Model.Filter.EventType is not null || Model.Filter.From is not null || Model.Filter.To is not null || !string.IsNullOrWhiteSpace(Model.Filter.Search);
}

@section Hero {
    <section class="rd-hero">
        <div class="container">
            <h1>Find your next<br /><em>finish line.</em></h1>
            <p class="mt-3 mb-4">Runs, walks and rides across South Africa. Pick an event, choose your category and get your bib in seconds.</p>
            @if (!Context.Session.IsSignedIn())
            {
                <a asp-controller="Auth" asp-action="Register" class="btn btn-primary btn-lg me-2"><i class="bi bi-person-plus-fill"></i> Join RaceDay</a>
                <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-light btn-lg">Log in</a>
            }
            else if (Context.Session.IsParticipant())
            {
                <a asp-controller="Participant" asp-action="MyEnrolments" class="btn btn-lime btn-lg"><i class="bi bi-ticket-perforated"></i> My enrolments</a>
            }
        </div>
    </section>
}

<partial name="_PageHeader" model='new PageHeader("Upcoming events", subtitle, "bi-calendar-event")' />

<form method="get" asp-action="Index" class="rd-card rd-card-body mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-lg-4 col-md-6">
            <label asp-for="Filter.Search" class="form-label"></label>
            <input asp-for="Filter.Search" class="form-control" placeholder="Event name, city or keyword" />
        </div>
        <div class="col-lg-2 col-md-6">
            <label asp-for="Filter.EventType" class="form-label"></label>
            <select asp-for="Filter.EventType" asp-items="Html.GetEnumSelectList<EventType>()" class="form-select">
                <option value="">All types</option>
            </select>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <label asp-for="Filter.From" class="form-label"></label>
            <input asp-for="Filter.From" type="date" class="form-control" />
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <label asp-for="Filter.To" class="form-label"></label>
            <input asp-for="Filter.To" type="date" class="form-control" />
        </div>
        <div class="col-lg-2 col-md-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-fill"><i class="bi bi-funnel-fill"></i> Filter</button>
            @if (hasFilters)
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Clear filters"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </div>
</form>

@if (Model.Events.Count == 0)
{
    <div class="rd-card">
        <div class="rd-empty">
            <i class="bi bi-calendar-x"></i>
            <h3>No events found</h3>
            <p>@(hasFilters ? "Try widening your filters." : "Check back soon: new races are added all the time.")</p>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var ev in Model.Events)
        {
            <div class="col-md-6 col-lg-4">
                <partial name="_EventCard" model="ev" />
            </div>
        }
    </div>
}
