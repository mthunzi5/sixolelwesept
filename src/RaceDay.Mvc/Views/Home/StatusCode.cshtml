@model int
@{
    var (title, message) = Model switch
    {
        404 => ("Page not found", "That page has left the course. It may have moved or never existed."),
        403 => ("Not allowed", "You don't have access to that page."),
        _ => ("Something went wrong", "We couldn't complete that request. Please try again.")
    };
    ViewData["Title"] = title;
}

<div class="rd-card">
    <div class="rd-empty">
        <div class="rd-error-code">@Model</div>
        <h3>@title</h3>
        <p>@message</p>
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index"><i class="bi bi-house-fill"></i> Back to events</a>
    </div>
</div>
