@{
    var session = Context.Session;
    var signedIn = session.IsSignedIn();
    var role = session.GetUserRole();
    var fullName = session.GetFullName();
    var avatar = Display.ImageSrc(session.GetString(SessionKeys.ProfileImageUrl));
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c, params string[] actions) =>
        string.Equals(controller, c, StringComparison.OrdinalIgnoreCase)
        && (actions.Length == 0 || actions.Contains(action, StringComparer.OrdinalIgnoreCase)) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string t ? $"{t} · RaceDay" : "RaceDay")</title>
    <link rel="icon" href="~/img/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;0,800;1,700;1,800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body class="@(role is UserRole r ? "rd-role-" + r.ToString().ToLowerInvariant() : "rd-role-guest")">
    <nav class="navbar navbar-expand-lg navbar-dark rd-navbar sticky-top">
        <div class="container">
            <a class="navbar-brand rd-brand" asp-controller="@(role == UserRole.Organiser ? "Organiser" : "Home")" asp-action="@(role == UserRole.Organiser ? "Dashboard" : "Index")">
                <span class="rd-brand-mark"><i class="bi bi-lightning-charge-fill"></i></span>
                RACE<span>DAY</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    @if (role == UserRole.Organiser)
                    {
                        <li class="nav-item"><a class="nav-link @Active("Organiser", "Dashboard")" asp-controller="Organiser" asp-action="Dashboard"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Organiser", "Events", "Create", "Edit", "Categories", "Enrolments", "Results")" asp-controller="Organiser" asp-action="Events"><i class="bi bi-calendar-event"></i> My Events</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Organiser" asp-action="Create"><i class="bi bi-plus-circle"></i> New Event</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Home", "Index", "Event", "Leaderboard")" asp-controller="Home" asp-action="Index"><i class="bi bi-globe2"></i> Public Events</a></li>
                    }
                    else if (role == UserRole.Participant)
                    {
                        <li class="nav-item"><a class="nav-link @Active("Home", "Index", "Event", "Leaderboard")" asp-controller="Home" asp-action="Index"><i class="bi bi-flag"></i> Events</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Participant", "MyEnrolments")" asp-controller="Participant" asp-action="MyEnrolments"><i class="bi bi-ticket-perforated"></i> My Enrolments</a></li>
                        <li class="nav-item"><a class="nav-link @Active("Participant", "MyResults")" asp-controller="Participant" asp-action="MyResults"><i class="bi bi-trophy"></i> My Results</a></li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link @Active("Home", "Index", "Event", "Leaderboard")" asp-controller="Home" asp-action="Index"><i class="bi bi-flag"></i> Events</a></li>
                    }
                </ul>

                <ul class="navbar-nav align-items-lg-center gap-lg-2">
                    @if (signedIn)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                @if (avatar is not null)
                                {
                                    <img src="@avatar" alt="" class="rd-avatar rd-avatar-sm" />
                                }
                                else
                                {
                                    <span class="rd-avatar rd-avatar-sm rd-avatar-initials">@Display.Initials(fullName)</span>
                                }
                                <span>@fullName</span>
                                <span class="rd-role-pill">@role</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index"><i class="bi bi-person-circle"></i> My Profile</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Auth" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right"></i> Log out</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link @Active("Auth", "Login")" asp-controller="Auth" asp-action="Login">Log in</a></li>
                        <li class="nav-item"><a class="btn btn-primary btn-sm px-3" asp-controller="Auth" asp-action="Register">Sign up</a></li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="rd-main">
        @if (IsSectionDefined("Hero"))
        {
            @RenderSection("Hero")
        }
        <div class="container py-4">
            <partial name="_Alerts" />
            @RenderBody()
        </div>
    </main>

    <footer class="rd-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between gap-2">
            <span><strong class="rd-brand-text">RACE<span>DAY</span></strong> · Run. Walk. Cycle. Finish strong.</span>
            <span class="text-white-50">&copy; @DateTime.Today.Year RaceDay</span>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
